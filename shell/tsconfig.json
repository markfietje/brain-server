{
	"extends": "$app/tsconfig",
	"include": [
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"e2e/**/*.ts",
		"*.config.ts"
	],
	"exclude": [
		"build",
		".svelte-kit",
		"node_modules",
		"src-tauri"
	],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"paths": {
			"$paraglide/*": [
				"./src/paraglide/*"
			]
		}
	}
}
