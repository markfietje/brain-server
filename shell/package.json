{
	"name": "brain-shell",
	"version": "0.1.0",
	"private": true,
	"description": "The SvelteTauri shell: the typed-wire skeleton + the wizard renderer (the C9 consumer). A pure protocol client — zero business logic; every read is a typed kernel call.",
	"type": "module",
	"engines": {
		"node": ">=24 <27",
		"pnpm": ">=12 <13"
	},
	"packageManager": "pnpm@12.11.2",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-csp.mjs",
		"preview": "vite preview",
		"gen:api": "openapi-typescript ../openapi.yaml -o src/lib/api/schema.d.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@zag-js/combobox": "^1.46.0",
		"@zag-js/dialog": "^1.46.0",
		"@zag-js/svelte": "^1.46.0",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.27.0",
		"@inlang/plugin-message-format": "^4.5.3",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.56.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/cli": "^2.12.3",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "^8.71.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"axe-core": "^4.14.0",
		"cn": "^0.4.0",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
