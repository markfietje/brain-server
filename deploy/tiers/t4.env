# T4 global — multi-site / multi-region (docs/deployment.md § "Deployment tiers")
# T3 plus site-to-site knowledge parcels and regional residency stamps;
# follow-the-sun handover via the shift ring. Federation itself stays v3.x.
BRAIN_WRITE_POSTURE=review
BRAIN_AUDIT_READ_EVENTS=on
BRAIN_MULTI_DB=1
BRAIN_MAX_DOMAIN_DBS=64
BRAIN_WEBHOOK_TIMESTAMP_REQUIRED=1

# Instrumented decision cores for multi-region ops visibility.
BRAIN_OTEL_ENABLED=1

# Regional load balancers terminate TLS; the proxy chain is trusted + bounded.
BRAIN_TRUST_PROXY=1
BIND_PUBLIC=0
