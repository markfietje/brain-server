{
	"name": "brain-shell",
	"version": "0.1.0",
	"private": true,
	"description": "The SvelteTauri shell: the typed-wire skeleton + the wizard renderer (the C9 consumer). A pure protocol client — zero business logic; every read is a typed kernel call.",
	"type": "module",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=12 <13"
	},
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inject-csp.mjs",
		"preview": "vite preview",
		"gen:api": "openapi-typescript ../openapi.yaml -o src/lib/api/schema.d.ts",
		"pretest": "pnpm run gen:api",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"tauri": "tauri"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"bits-ui": "2.19.3",
		"openapi-fetch": "^0.17.0",
		"svelte-i18n": "^4.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/cli": "^2.11.5",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.6.0",
		"@types/node": "^24.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"axe-core": "^4.10.0",
		"cn": "^0.4.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
