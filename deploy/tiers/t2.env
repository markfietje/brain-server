# T2 team — a small team (≤ ~25 agents) (docs/deployment.md § "Deployment tiers")
# Roles enabled via scoped JWT principals; HITL proposal review queue on.
# Write posture review: agent writes land as proposals.
BRAIN_WRITE_POSTURE=review

# Every read of case content is audited once teams share the surface.
BRAIN_AUDIT_READ_EVENTS=on

# Loopback behind the operator's own reverse proxy; never public without auth.
BIND_PUBLIC=0
