# T1 solo — one operator / micro-centre (docs/deployment.md § "Deployment tiers")
# Loopback bind, single domain, single DB, no roles. The operator IS the
# reviewer: write posture open, proposals still audited.
BRAIN_WRITE_POSTURE=open

# Auth is optional at T1 ONLY because the bind stays loopback; the server
# fails closed on any non-loopback bind without auth regardless of tier.
BIND_PUBLIC=0
