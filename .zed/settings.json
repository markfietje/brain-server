// Project-local Zed settings — Tailwind CSS v4 support.
// client/styles/input.css uses @theme/@source/@apply (valid Tailwind v4, verified
// via context7). The generic vscode-css-language-server doesn't understand those
// at-rules and emits false "Unknown at rule" warnings. The documented fix
// (https://zed.dev/docs/languages/tailwindcss#using-tailwind-css-mode-in-css-files)
// is to use the Tailwind CSS language mode (tailwindcss-intellisense-css), which
// provides full CSS IntelliSense WITH Tailwind at-rule support, and disable the
// generic server. The "..." keeps other servers (e.g. tailwindcss-language-server
// for class completion). No input.css changes needed.
//
// rust-analyzer: this repo holds multiple Cargo workspaces — the server crate at
// the root (brain-server + its bins), the Dioxus client at client/ (brain-client,
// its own Cargo.lock), and the standalone engine crates under crates/* (each its
// own Cargo.toml, not members of the root workspace). Without `linkedProjects`
// rust-analyzer attaches to only the one it finds first, so the other trees show
// as plain text with no diagnostics. Listing every manifest attaches one analysis
// session per workspace.
{
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "!tailwindcss-language-server",
        "..."
      ]
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "./Cargo.toml",
          "./client/Cargo.toml",
          "./crates/brain-consensus-core/Cargo.toml",
          "./crates/brain-executor-core/Cargo.toml",
          "./crates/brain-interview-core/Cargo.toml",
          "./crates/brain-troubleshoot-core/Cargo.toml",
          "./crates/legal-rules-db/Cargo.toml"
        ]
      }
    }
  }
}
