{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "StewardMem",
	"version": "1.0.0",
	"identifier": "com.stewardmem.shell",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "StewardMem",
				"label": "main",
				"width": 1024,
				"height": 768,
				"resizable": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8765",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'self'",
				"worker-src": "'self'",
				"frame-ancestors": "'none'"
			}
		}
	},
	"bundle": {
		"active": true,
		"icon": ["icons/icon.png"]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyN0MxRTExMTk2MDYyRDUKUldUVlltQVpFUjU4d3J1MExwYmhzQWF0bS9XTUM3VGQwcFhhd3lrV0xHbVRpaTF3ZWt1SUNSUjkK",
			"endpoints": [
				"https://github.com/stewardmem/stewardmem/releases/latest/download/latest.json"
			],
			"requireSignedVersion": true,
			"allowDowngrades": false
		}
	}
}
