// Project-local Zed settings — editor posture for this repo.
//
// CSS: client/styles/input.css uses @theme/@source/@apply (valid Tailwind v4).
// EVERY CSS language server is disabled project-wide — the generic
// vscode-css-language-server false-flags the at-rules, and even the
// tailwindcss-intellisense-css server emits rename lints on load. The file is
// verified by the real compiler (tailwindcss v4 via Dioxus) and by
// `scripts/sync-plugin.sh`; open a css file expecting no squiggles.
//
// TypeScript: plugin/ (the OpenClaw extension mirror) is plain TS but is NOT
// type-checked here — its tsc + vitest run inside the openclaw workspace
// (~/Sites/openclaw), where @openclaw/plugin-sdk resolves. Disabling the TS
// servers project-wide stops false "cannot find module" diagnostics for that
// workspace-only import.
//
// rust-analyzer: this repo holds multiple Cargo workspaces — the server crate at
// the root (brain-server + its bins), the Dioxus client at client/ (brain-client,
// its own Cargo.lock), and the standalone engine crates under crates/* (each its
// own Cargo.toml, not members of the root workspace). Without `linkedProjects`
// rust-analyzer attaches to only the one it finds first, so the other trees show
// as plain text with no diagnostics. Listing every manifest attaches one analysis
// session per workspace.
{
  "languages": {
    "CSS": {
      "language_servers": [
        "!vscode-css-language-server",
        "!tailwindcss-language-server",
        "!tailwindcss-intellisense-css"
      ]
    },
    "TypeScript": {
      "language_servers": ["!typescript-language-server", "!vtsls"]
    },
    "TSX": {
      "language_servers": ["!typescript-language-server", "!vtsls"]
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "./Cargo.toml",
          "./client/Cargo.toml",
          "./crates/brain-consensus-core/Cargo.toml",
          "./crates/brain-executor-core/Cargo.toml",
          "./crates/brain-interview-core/Cargo.toml",
          "./crates/brain-troubleshoot-core/Cargo.toml",
          "./crates/legal-rules-db/Cargo.toml"
        ]
      }
    }
  }
}
