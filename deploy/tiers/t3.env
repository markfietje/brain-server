# T3 site — a site or BPO campaign (docs/deployment.md § "Deployment tiers")
# Multi-domain/multi-DB, monthly human-signed calibration, public KB feedback
# loop live, WFM feeds (/ops/shifts, /ops/skills) feeding the centre's tool.
BRAIN_WRITE_POSTURE=review
BRAIN_AUDIT_READ_EVENTS=on

# Domain-per-campaign DBs under an explicit cap (bounds law).
BRAIN_MULTI_DB=1
BRAIN_MAX_DOMAIN_DBS=16

# First-party webhook senders verify the Standard Webhooks timestamp set.
BRAIN_WEBHOOK_TIMESTAMP_REQUIRED=1
BIND_PUBLIC=0
