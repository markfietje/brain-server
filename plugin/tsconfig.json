{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "typeRoots": ["../../openclaw/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "openclaw/plugin-sdk/plugin-entry": ["../../openclaw/.artifacts/build-all-cache/write-plugin-sdk-entry-dts/outputs/dist/plugin-sdk/plugin-entry.d.ts"],
      "openclaw/plugin-sdk/types": ["../../openclaw/.artifacts/build-all-cache/write-plugin-sdk-entry-dts/outputs/dist/plugin-sdk/types.d.ts"],
      "typebox": ["../../openclaw/node_modules/typebox"]
    }
  },
  "include": ["./*.ts", "./src/**/*.ts"],
  "exclude": ["./**/*.test.ts", "./dist/**", "./node_modules/**"]
}
