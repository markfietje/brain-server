{
	"app": {
		"windows": [
			{
				"title": "StewardMem",
				"label": "main",
				"width": 1024,
				"height": 768,
				"resizable": true,
				"titleBarStyle": "Overlay",
				"transparent": true,
				"windowEffects": {
					"effects": [
						"sidebar"
					],
					"state": "followsWindowActiveState"
				}
			}
		]
	},
	"bundle": {
		"externalBin": [
			"binaries/brain-server",
			"binaries/brain-afm"
		],
		"resources": [
			"binaries/SIDECAR_PROVENANCE.json"
		],
		"macOS": {
			"minimumSystemVersion": "15.0",
			"hardenedRuntime": true,
			"signingIdentity": "-"
		}
	}
}
